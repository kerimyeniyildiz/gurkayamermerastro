---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';
import { CONTACT_INFO } from '../../constants';

// Her yazı kendi adresine sahip statik bir sayfa olur.
// Eski tasarımda tüm blog tek sayfaydı ve yazılar tarayıcıda açılıyordu;
// yani yazıların ayrı adresi yoktu ve arama motoruna görünmüyorlardı.
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.draft !== true);
  const sorted = [...posts].sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

  return sorted.map((post) => ({
    params: { slug: post.id },
    props: { post, others: sorted.filter((item) => item.id !== post.id).slice(0, 5) },
  }));
}

const { post, others } = Astro.props;
const { Content } = await render(post);

const formatDate = (value: Date) =>
  value.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  image: post.data.image,
  datePublished: post.data.publishedAt.toISOString(),
  author: { '@type': 'Organization', name: 'Gürkaya Mermer Granit' },
  publisher: { '@type': 'Organization', name: 'Gürkaya Mermer Granit' },
  mainEntityOfPage: `https://gurkayamermer.com/blog/${post.id}/`,
};
---

<MainLayout
  title={`${post.data.title} | Gürkaya Mermer`}
  description={post.data.excerpt}
  canonicalPath={`/blog/${post.id}`}
  activePage="blog"
  ogType="article"
  ogImage={post.data.image}
  structuredData={articleSchema}
>
  <div class="bg-white min-h-screen animate-fade-in pb-20">
    <div class="relative h-[40vh] md:h-[50vh] w-full">
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent z-10"></div>
      <img src={post.data.image} alt={post.data.title} loading="eager" fetchpriority="high" decoding="async" class="w-full h-full object-cover" />
      <div class="absolute top-6 left-6 z-20">
        <a href="/blog/" class="bg-white/90 hover:bg-white text-emerald-950 px-4 py-2 rounded-full flex items-center gap-2 text-sm font-medium transition-colors shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          Blog'a Dön
        </a>
      </div>
      <div class="absolute bottom-0 left-0 w-full p-6 md:p-12 z-20 text-white">
        <div class="container mx-auto">
          <span class="bg-amber-600 text-white text-xs font-bold px-3 py-1 rounded-sm uppercase tracking-wider mb-3 inline-block">{post.data.category}</span>
          <h1 class="font-serif text-3xl md:text-5xl lg:text-6xl leading-tight mb-4">{post.data.title}</h1>
          <div class="flex items-center gap-6 text-sm md:text-base text-white/80">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
              {formatDate(post.data.publishedAt)}
            </div>
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              {post.data.readingTime}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="container mx-auto px-6 py-12">
      <div class="flex flex-col lg:flex-row gap-12">
        <div class="lg:w-2/3">
          <div class="prose prose-lg prose-stone max-w-none">
            <p class="lead text-xl text-stone-600 font-serif italic mb-8 border-l-4 border-amber-500 pl-4">{post.data.excerpt}</p>
            <div class="text-stone-700 leading-relaxed [&>p]:mb-6 [&>h2]:font-serif [&>h2]:text-emerald-950 [&>h2]:text-2xl [&>h2]:mt-10 [&>h2]:mb-4 [&>h3]:font-serif [&>h3]:text-emerald-950 [&>h3]:text-xl [&>h3]:mt-8 [&>h3]:mb-3 [&>ul]:list-disc [&>ul]:pl-6 [&>ul]:mb-6 [&>ol]:list-decimal [&>ol]:pl-6 [&>ol]:mb-6 [&_strong]:text-emerald-950 [&_strong]:font-serif [&_a]:text-amber-700 [&_a]:underline">
              <Content />
            </div>
          </div>

          <div class="mt-12 pt-8 border-t border-stone-200 flex flex-col md:flex-row justify-between items-center gap-6">
            <div class="flex items-center gap-2 text-stone-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
              <span class="text-sm">Bu yazıyı paylaşın</span>
            </div>
            <a
              href={`https://wa.me/${CONTACT_INFO.whatsapp}?text=${encodeURIComponent(`Merhaba, "${post.data.title}" yazınızı okudum, konuyla ilgili bilgi almak istiyorum.`)}`}
              target="_blank"
              rel="noreferrer"
              class="bg-emerald-950 text-white px-8 py-3 rounded-sm font-medium hover:bg-emerald-900 transition-colors w-full md:w-auto text-center"
            >
              Uzmanımıza Danışın
            </a>
          </div>
        </div>

        {others.length > 0 && (
          <div class="lg:w-1/3">
            <div class="bg-stone-50 p-6 rounded-sm border border-stone-100 sticky top-24">
              <h2 class="font-serif text-xl text-emerald-950 mb-6 pb-2 border-b border-stone-200">Diğer Yazılar</h2>
              <div class="flex flex-col gap-6">
                {others.map((item) => (
                  <a href={`/blog/${item.id}/`} class="group cursor-pointer flex gap-4 items-start">
                    <img src={item.data.image} alt={item.data.title} loading="lazy" decoding="async" class="w-20 h-20 object-cover rounded-sm group-hover:opacity-80 transition-opacity" />
                    <div>
                      <h3 class="font-serif text-sm font-bold text-emerald-950 group-hover:text-amber-700 transition-colors line-clamp-2 mb-1">{item.data.title}</h3>
                      <span class="text-xs text-stone-400">{formatDate(item.data.publishedAt)}</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</MainLayout>
