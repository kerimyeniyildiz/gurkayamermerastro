---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

// Yazılar derleme sırasında okunur; içerik HTML'e gömülür.
// (Eskiden tarayıcıdan CMS'e istek atılıyordu ve Google hiçbir şey göremiyordu.)
const posts = (await getCollection('blog', ({ data }) => data.draft !== true))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const formatDate = (value: Date) =>
  value.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<MainLayout
  title="Blog | Gürkaya Mermer"
  description="Mermer, granit, kuvars ve porselen tezgah seçimleri, bakım önerileri ve uygulama trendleri hakkında blog içerikleri."
  canonicalPath="/blog"
  activePage="blog"
>
  <div class="bg-stone-50 min-h-screen animate-fade-in pb-20">
    <div class="bg-emerald-950 text-white py-20 relative overflow-hidden">
      <div class="absolute inset-0 opacity-5 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>
      <div class="container mx-auto px-6 relative z-10 text-center">
        <span class="text-amber-500 font-bold tracking-[0.2em] uppercase text-xs mb-3 block">Gürkaya Blog</span>
        <h1 class="font-serif text-5xl md:text-6xl mb-4">Taşın Dünyası</h1>
        <p class="text-emerald-100/60 font-light max-w-lg mx-auto text-lg">Mermer bakımı, dekorasyon trendleri ve teknik bilgiler.</p>
      </div>
    </div>

    <div class="container mx-auto px-6 py-16 -mt-10 relative z-20">
      {posts.length === 0 && (
        <div class="text-center text-stone-500 mb-8">Henüz blog yazısı yok.</div>
      )}

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="bg-white rounded-sm shadow-lg overflow-hidden group cursor-pointer flex flex-col h-full border border-transparent hover:border-amber-200 transition-all duration-300"
          >
            <div class="relative aspect-[16/10] overflow-hidden">
              <img src={post.data.image} alt={post.data.title} loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
              <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm px-3 py-1 text-xs font-bold uppercase tracking-wider text-emerald-950">{post.data.category}</div>
            </div>

            <div class="p-8 flex flex-col flex-1">
              <div class="flex items-center gap-2 text-stone-400 text-xs mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                {formatDate(post.data.publishedAt)}
              </div>

              <h2 class="font-serif text-xl text-emerald-950 mb-3 group-hover:text-amber-700 transition-colors">{post.data.title}</h2>

              <p class="text-stone-500 text-sm leading-relaxed line-clamp-3 mb-6 flex-1">{post.data.excerpt}</p>

              <div class="flex items-center text-emerald-900 font-bold text-sm gap-2 group-hover:gap-3 transition-all">
                Devamını Oku
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</MainLayout>
